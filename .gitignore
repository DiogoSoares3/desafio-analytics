# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache

# Virtual environments
.venv

# Claude Code: version the shared skills (the dev-loop methodology), ignore local settings/state
.claude/*
!.claude/skills/

# Obsidian (local personal vault config)
.obsidian/

# Personal/extra-official docs (not part of the deliverable)
/docs/private/

# dbt artifacts
target/
dbt_packages/
logs/
*.duckdb
*.duckdb.wal
.user.yml

# Local data (DuckDB + raw exports); keep the dir, ignore contents
/data/*
!/data/.gitkeep
# ...but commit the AdventureWorks Parquet source-of-record (the grader gets it in the clone)
!/data/adventure_works/
/data/adventure_works/*
!/data/adventure_works/*.parquet